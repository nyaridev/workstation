{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workstation",
  "version": "0.1.0",
  "identifier": "com.nyaridev.workstation",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:4420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGNjEwNzQ2MjYyQzIxNTcKUldSWElTd21SZ2RoZjF6MWVsYkVPOEQyK1BZZTdMYkt5RWdYbmZ5SlIzOWxrNWU4NEZsOXViNlkK",
      "endpoints": ["https://github.com/nyaridev/workstation/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
