{
  "name": "workstation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "check": "node scripts/check-size.mjs && node scripts/check-boundaries.mjs && tsc && biome check . && vitest run --passWithNoTests && cargo test --manifest-path src-tauri/Cargo.toml",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "iro-ui": "github:nyaridev/iro-ui#v1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  },
  "description": "Desktop overseer for a WORKSTATION folder: lists every project and watches for new ones.",
  "engines": {
    "node": ">=22.18.0"
  }
}
